<Project Sdk="Microsoft.NET.Sdk">

  <!--
    macOS menu bar app (Avalonia). Shares all quota logic with the Windows app through
    QuotaLens.Core. Packaged into QuotaLens.app by publish-mac.sh.
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net6.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>QuotaLens</AssemblyName>
    <RootNamespace>QuotaLens.Mac</RootNamespace>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <BuiltInComInteropSupport>false</BuiltInComInteropSupport>
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.3.22" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.22" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.22" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\QuotaLens.Core\QuotaLens.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="Packaging\**" />
  </ItemGroup>

</Project>
